# ============================================================
# Nagar-Drishti (नगर-दृष्टि) Environment Configuration
# ============================================================

# Application Environment
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo Mode (Set to true to use built-in high-fidelity seed datasets and offline fallbacks)
DEMO_MODE=true

# Google Gemini API (Used for 3.5 / 2.5 Flash multimodal classification, troll filtering & VLM Proof-of-Clearance)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Replicate API Token (Used for FLUX.1 Fill [dev] inpainting to generate "Vision of Tomorrow")
# Get a key at: https://replicate.com/
REPLICATE_API_TOKEN=

# Supabase Credentials (Optional: if empty, an in-memory/localStorage mock store is used automatically)
# Get free project at: https://supabase.com/
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Twilio WhatsApp Business API (Optional: used for live WhatsApp webhook testing)
# Get free sandbox at: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# CARTO Basemaps API Key (For high-performance dark raster tiles without watermark)
# Get a free key at: https://carto.com/basemaps/apikey
NEXT_PUBLIC_CARTO_API_KEY=

# Inngest (Optional: for background job orchestration)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

